EXPO_PUBLIC_GOOGLE_MAPS_KEY=YOUKEYHERE

# Optional. Only needed to point the app somewhere other than the local backend during development.
#
# Leave it unset and dev builds use http://localhost:8080/api/ — 10.0.2.2 on Android, since the
# emulator cannot see your machine's localhost — which is the same server Swagger reads from.
# Release builds use the deployed API and ignore this entirely.
#
# Set it for a physical device, which resolves localhost to itself rather than to your machine:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api/
#
# The two servers have separate databases and separate JWT signing secrets, so a token from one is
# not accepted by the other. Pointing the app and Swagger at different hosts is the usual reason a
# driver sees different trips in the app than in the API docs.
# EXPO_PUBLIC_API_URL=
